rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an authenticated admin
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Products: Public can view active feeds; admins have full access
    match /products/{productId} {
      allow read: if resource.data.is_active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Categories: Public can view active categories; admins have full access
    match /categories/{categoryId} {
      allow read: if resource.data.is_active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Store Settings: Public can read store contact & delivery settings; admins can update
    match /store_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Public can submit orders with valid fields; admins can view and manage all orders
    match /orders/{orderId} {
      allow create: if request.resource.data.customer_name != null
                    && request.resource.data.customer_phone != null
                    && request.resource.data.full_address != null
                    && request.resource.data.total_bags > 0
                    && request.resource.data.total_amount >= 0;
      allow read: if isAdmin() || (resource.data.order_number != null);
      allow update, delete: if isAdmin();
    }

    // Inventory Movements: Internal audit log. Admins can view; system transaction writes movements
    match /inventory_movements/{movementId} {
      allow read: if isAdmin();
      allow create: if true; // Allowed when order transactions adjust stock
      allow update, delete: if isAdmin();
    }

    // User & Admin profiles
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
